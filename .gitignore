worker/.wrangler/

# Node (web/ SPA)
node_modules/

# Jekyll docs build output, caches, and Ruby gems
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
vendor/
.bundle/

# Python
__pycache__/
*.pyc

# Editors / OS
.vscode/
.settings/
.DS_Store
*.swp

# AI working files
.claude
